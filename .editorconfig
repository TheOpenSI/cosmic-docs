# EditorConfig: https://editorconfig.org
# CoSMIC conventions: docs/conventions/EDITORCONFIG.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
spelling_language = en-AU

[*.{ts,tsx,js,jsx,css}]
indent_style = tab
indent_size = 4

[*.{json,yaml,yml,html}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false